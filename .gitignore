__pycache__/
*.pyc
*.egg-info/
# Exclude checkpoints and training outputs; publish only the selected stage-1 model.
checkpoints/
/logs/*
!/logs/pgmt_stage1/
/logs/pgmt_stage1/*
!/logs/pgmt_stage1/pgmt_8192x20000/
/logs/pgmt_stage1/pgmt_8192x20000/*
!/logs/pgmt_stage1/pgmt_8192x20000/model_15000.pt
exported_models/
wandb/
